# Docker Compose — copy to .env and fill in values
# Do NOT commit .env to git

APP_ENV=local
APP_DEBUG=true

# Laravel app key — generate with: php artisan key:generate
APP_KEY=

# JWT secret — generate with: php artisan jwt:secret
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# Database
DB_ROOT_PASSWORD=secret
DB_USERNAME=mock_exam
DB_PASSWORD=secret
