APP_NAME="Mock Exam System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mock_exam
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# One-Login shared authentication foundation (2026-09, Phase 5 of the auth-unification
# effort). SHARED_JWT_SECRET must be set to the EXACT SAME value as exam-history-
# management's own JWT_SECRET once this is wired up for real — leave unset until then;
# the shared-JWT verification path (App\Services\SharedJwtVerifier) fails closed and this
# app keeps authenticating exactly as it does today (its own JWT_SECRET above) until it's
# configured. Never commit a real secret value here.
SHARED_JWT_SECRET=
SHARED_JWT_COOKIE_NAME=jwt_token

CACHE_STORE=database
SESSION_DRIVER=database
QUEUE_CONNECTION=database
